# The website, built by fuguweb(1).

site   = FuguVM
url    = https://vm.fugubsd.org/
footer = footer.body.html

nav "index.html" {
	label = Home
}

nav "manuals.html" {
	label = Manuals
}

page "index.html" {
	title = Home
	body  = index.body.html
}

page "manuals.html" {
	title = Manuals
	index = yes
	body  = manuals.body.html
}

page "404.html" {
	title    = Not found
	body     = 404.body.html
	unlinked = yes
}

manuals commands {
	heading = Commands
	dir     = man/fuguvm
}

modules modules {
	heading = Modules
	dir     = lib/App/FuguVM
}
